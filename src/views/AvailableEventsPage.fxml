<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AvailableEventsPageController"
            stylesheets="@style.css">

    <top>
        <VBox styleClass="top-bar">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <padding>
                    <Insets top="15" right="20" bottom="15" left="20"/>
                </padding>

                <Label text="Available Events" styleClass="welcome-text">
                    <font>
                        <Font name="Arial Bold" size="20"/>
                    </font>
                </Label>

                <HBox HBox.hgrow="ALWAYS" />

                <Label fx:id="welcomeLabel" text="Welcome!">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>

                <Button text="Back" onAction="#handleBack" styleClass="secondary-button"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="gray-container">
                <padding>
                    <Insets top="10" right="20" bottom="10" left="20"/>
                </padding>

                <Label text="Search:">
                    <font>
                        <Font size="13"/>
                    </font>
                </Label>
                <TextField fx:id="searchField" promptText="Search events..." prefWidth="200"/>

                <Label text="Type:">
                    <font>
                        <Font size="13"/>
                    </font>
                </Label>
                <ComboBox fx:id="eventTypeCombo" prefWidth="150"/>

                <Button text="Search" onAction="#handleSearch" styleClass="primary-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" styleClass="card">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="eventNameCol" text="Event Name" prefWidth="150"/>
                    <TableColumn fx:id="eventTypeCol" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="eventDateCol" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="locationCol" text="Location" prefWidth="150"/>
                    <TableColumn fx:id="priceCol" text="Price (SAR)" prefWidth="100"/>
                    <TableColumn fx:id="availableSeatsCol" text="Available Seats" prefWidth="120"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="Number of Tickets:">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>
                <TextField fx:id="numTicketsField" promptText="1" prefWidth="80"/>
                <Button text="Book Event" onAction="#handleBookEvent" prefWidth="120" styleClass="success-button">
                    <font>
                        <Font size="14"/>
                    </font>
                </Button>
            </HBox>
        </VBox>
    </center>

</BorderPane>
