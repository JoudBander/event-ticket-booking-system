<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.RegisterController">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER" styleClass="top-bar">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label text="Event Ticket Booking System - Registration">
                <font>
                    <Font name="Arial Bold" size="18" />
                </font>
            </Label>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox alignment="CENTER" spacing="10" styleClass="gray-container">
            <padding>
                <Insets bottom="15" left="40" right="40" top="15" />
            </padding>

            <!-- Title -->
            <Label styleClass="title-label" text="Create New Account">
                <font>
                    <Font name="Arial Bold" size="22" />
                </font>
            </Label>

            <!-- Registration Form -->
            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20 25 25 25;">
                <VBox.margin>
                    <Insets top="5" />
                </VBox.margin>

                <!-- Username Field -->
                <VBox spacing="3" prefWidth="380">
                    <Label text="Username:">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>
                    <TextField fx:id="usernameField" promptText="3-20 characters" prefHeight="32" styleClass="text-field">
                        <font>
                            <Font size="13" />
                        </font>
                    </TextField>
                </VBox>

                <!-- Password Field -->
                <VBox spacing="3" prefWidth="380">
                    <Label text="Password:">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>
                    <PasswordField fx:id="passwordField" promptText="At least 6 characters" prefHeight="32" styleClass="text-field">
                        <font>
                            <Font size="13" />
                        </font>
                    </PasswordField>
                </VBox>

                <!-- Confirm Password Field -->
                <VBox spacing="3" prefWidth="380">
                    <Label text="Confirm Password:">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>
                    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" prefHeight="32" styleClass="text-field">
                        <font>
                            <Font size="13" />
                        </font>
                    </PasswordField>
                </VBox>

                <!-- Full Name Field -->
                <VBox spacing="3" prefWidth="380">
                    <Label text="Full Name:">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>
                    <TextField fx:id="fullNameField" promptText="Enter your full name" prefHeight="32" styleClass="text-field">
                        <font>
                            <Font size="13" />
                        </font>
                    </TextField>
                </VBox>

                <!-- Email Field -->
                <VBox spacing="3" prefWidth="380">
                    <Label text="Email:">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>
                    <TextField fx:id="emailField" promptText="example@gmail.com" prefHeight="32" styleClass="text-field">
                        <font>
                            <Font size="13" />
                        </font>
                    </TextField>
                </VBox>

                <!-- Phone Field -->
                <VBox spacing="3" prefWidth="380">
                    <Label text="Phone:">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>
                    <TextField fx:id="phoneField" promptText="05XXXXXXXX (10 digits)" prefHeight="32" styleClass="text-field">
                        <font>
                            <Font size="13" />
                        </font>
                    </TextField>
                </VBox>

                <!-- User Type ComboBox -->
                <VBox spacing="3" prefWidth="380">
                    <Label text="Register as:">
                        <font>
                            <Font size="14" />
                        </font>
                    </Label>
                    <ComboBox fx:id="userTypeCombo" promptText="Select user type" prefHeight="32" prefWidth="380" styleClass="combo-box" style="-fx-font-size: 13;" />
                </VBox>

                <!-- Status Label -->
                <Label fx:id="statusLabel" text="" textFill="#d32f2f">
                    <font>
                        <Font size="13" />
                    </font>
                </Label>

                <!-- Buttons -->
                <HBox alignment="CENTER" spacing="20">
                    <VBox.margin>
                        <Insets top="10" />
                    </VBox.margin>

                    <Button text="Register" onAction="#handleRegister" prefWidth="190" prefHeight="38" styleClass="primary-button">
                        <font>
                            <Font size="15" />
                        </font>
                    </Button>

                    <Button text="Back to Login" onAction="#handleBackToLogin" prefWidth="190" prefHeight="38" styleClass="secondary-button">
                        <font>
                            <Font size="15" />
                        </font>
                    </Button>
                </HBox>

            </VBox>

        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" styleClass="footer">
            <padding>
                <Insets bottom="10" top="10" />
            </padding>
            <Label text="CS 313 - Event Ticket Booking System © 2024">
                <font>
                    <Font size="11" />
                </font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>
